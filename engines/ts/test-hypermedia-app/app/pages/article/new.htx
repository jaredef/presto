<!-- Layer 0: Create form with signed mutation token.
     htx:action generates an HMAC-SHA256 token. Zero client JS.
     Escape: add client-side validation (Layer 2). -->

<section class="app-section" style="max-width:600px">
  <h1>Create Article</h1>
  <htx:component src="/ui/form.htx" action="create" type="article">
    <htx:component src="/ui/input.htx" label="Title" type="text" name="title" required="required" />
    <htx:component src="/ui/textarea.htx" label="Body" name="body" rows="6" />
    <htx:component src="/ui/select.htx" label="Status" name="status">
      <option value="draft">Draft</option>
      <option value="published">Published</option>
    </htx:component>
  </htx:component>
  <a href="/article" style="display:inline-block;margin-top:1rem">&larr; Cancel</a>
</section>
