<!-- Layer 0: Delete confirmation with signed token.
     Two-step: GET shows confirmation, POST executes deletion. -->

<htx:data type="article" where="slug = '{htx:params.slug}'" limit="1" as="item_list" />
<htx:each items="item_list" as="item">
<section class="app-section" style="max-width:500px">
  <htx:component src="/ui/alert.htx" variant="error" title="Delete Article">
    Are you sure you want to delete this article? This action cannot be undone.
  </htx:component>
  <div style="margin-top:1.5rem">
    <htx:component src="/ui/form.htx" action="delete" type="article" record="{htx:item.id}">
    </htx:component>
  </div>
  <a href="/article/{htx:item.slug}" style="display:inline-block;margin-top:1rem">&larr; Cancel</a>
</section>
<htx:empty />
<section class="app-section">
  <h1>Article not found</h1>
</section>
</htx:each>
