---
// This is an Astro page — server-rendered at build time
const title = "Astro Island";
const features = [
  { name: "Zero JS by default", desc: "Astro ships no JavaScript unless you opt in" },
  { name: "Component islands", desc: "Hydrate interactive components independently" },
  { name: "Content collections", desc: "Type-safe markdown and MDX content" },
  { name: "View transitions", desc: "Native browser transitions between pages" },
];
const builtAt = new Date().toISOString();
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; padding: 1.5rem; background: #fefce8; color: #1a1a1a; }
    h1 { font-size: 1.5rem; margin: 0 0 0.5rem; }
    .subtitle { color: #888; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .feature { padding: 0.75rem; border: 1px solid #e5e5e5; border-radius: 8px; margin-bottom: 0.5rem; background: #fff; }
    .feature h3 { margin: 0; font-size: 0.9rem; }
    .feature p { margin: 0.25rem 0 0; font-size: 0.8rem; color: #666; }
    .meta { margin-top: 1.5rem; font-size: 0.7rem; color: #aaa; }
    .badge { display: inline-block; font-size: 0.65rem; padding: 0.15rem 0.5rem; border-radius: 100px; background: #fef3c7; color: #92400e; font-weight: 600; }
  </style>
</head>
<body>
  <span class="badge">Astro 6</span>
  <h1>{title}</h1>
  <p class="subtitle">This HTML was compiled by Astro at build time. It is served as a static file inside a PRESTO page.</p>

  {features.map(f => (
    <div class="feature">
      <h3>{f.name}</h3>
      <p>{f.desc}</p>
    </div>
  ))}

  <div class="meta">
    Built at: {builtAt}<br/>
    Framework: Astro 6 — server-first, zero JS by default<br/>
    This output is static HTML. It lives in an iframe within a PRESTO representation alongside a React SPA island.
  </div>
</body>
</html>
