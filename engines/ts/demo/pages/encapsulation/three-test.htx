<htx:layout none />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Three.js Debug</title>
  <style>
    body { margin: 0; padding: 2rem; font-family: system-ui, sans-serif; background: #fafafa; }
    #direct-mount { width: 600px; height: 400px; border: 2px solid red; }
    #island-mount { width: 600px; height: 400px; border: 2px solid blue; margin-top: 1rem; }
  </style>
</head>
<body>
  <h2>Test 1: Direct mount (no island protocol)</h2>
  <div id="direct-mount"></div>

  <h2 style="margin-top:2rem">Test 2: Via island.htx component</h2>
  <div style="width:600px;height:400px;border:2px solid blue">
    <htx:component src="/ui/island.htx" name="three-scene">
      <div style="padding:2rem;text-align:center;color:#888">Loading via island protocol...</div>
    </htx:component>
  </div>

  <h2 style="margin-top:2rem">Test 3: Raw WebGL (like presto-c)</h2>
  <canvas id="raw-canvas" width="600" height="400" style="border:2px solid green;display:block;margin-top:1rem"></canvas>

  <!-- Direct mount for Test 1 -->
  <script type="module">
    import('/js/islands/three-scene.js').then(() => {
      const registry = window.__prestoIslands || {};
      const island = registry['three-scene'];
      if (island) {
        const el = document.getElementById('direct-mount');
        island.mount(el, {});
        console.log('Direct mount: done', el.offsetWidth, el.offsetHeight);
      } else {
        console.log('Island not found in registry');
      }
    });
  </script>

  <!-- Raw WebGL for Test 3 -->
  <script>
  (function() {
    var canvas = document.getElementById('raw-canvas');
    var gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
    if (!gl) { console.log('No WebGL'); return; }
    gl.clearColor(0.04, 0.04, 0.06, 1.0);
    gl.clear(gl.COLOR_BUFFER_BIT);
    // Draw a simple colored triangle to prove WebGL works
    var vs = 'attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}';
    var fs = 'precision mediump float;void main(){gl_FragColor=vec4(0.39,0.4,0.95,1.0);}';
    function sh(t,s){var o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);return o;}
    var prog=gl.createProgram();
    gl.attachShader(prog,sh(gl.VERTEX_SHADER,vs));
    gl.attachShader(prog,sh(gl.FRAGMENT_SHADER,fs));
    gl.linkProgram(prog);gl.useProgram(prog);
    var buf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buf);
    gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([0,0.5,-0.5,-0.5,0.5,-0.5]),gl.STATIC_DRAW);
    var loc=gl.getAttribLocation(prog,'p');gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
    gl.drawArrays(gl.TRIANGLES,0,3);
    console.log('Raw WebGL: rendered');
  })();
  </script>
</body>
</html>
