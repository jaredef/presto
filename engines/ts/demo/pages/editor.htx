<htx:data type="project" order="id desc" limit="50" as="projects" />

<div style="max-width:800px;margin:3rem auto;padding:0 1.5rem">
  <div style="margin-bottom:2rem">
    <h1 style="margin:0 0 0.25rem">PRESTO Builder</h1>
    <p style="color:var(--ui-text-muted)">Visual page editor + AI chat. Two paradigms, one representation.</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));gap:1rem">
    <htx:each items="projects" as="proj">
    <a href="/editor/{htx:proj.slug}" style="text-decoration:none">
      <div class="ui-card" style="cursor:pointer">
        <div class="ui-card-header">
          <h3 class="ui-card-title"><htx:v>proj.name</htx:v></h3>
          <p class="ui-card-description">Project</p>
        </div>
        <div class="ui-card-content" style="padding:0.75rem 1.5rem">
          <span style="font-size:0.8rem;color:var(--ui-text-muted)">Click to open</span>
        </div>
      </div>
    </a>
    <htx:empty />
    <div class="ui-alert ui-alert-info" role="alert">
      <div class="ui-alert-title">No projects yet</div>
      <div class="ui-alert-body">Create your first project to start building.</div>
    </div>
    </htx:each>
  </div>
</div>
