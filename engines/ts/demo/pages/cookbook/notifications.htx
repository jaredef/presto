<!-- MID-DEPTH (Layer 4): Real-time notification feed.
     Replaces: Pusher/Socket.io + React state + toast library + global store.
     htx:grant materializes a channel token. Script simulates live updates. -->

<htx:grant type="channel" module="builder" as="notifyToken" />

<h1>Notification Feed</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1.5rem">Real-time notifications via channel grant. Replaces Pusher + React state.</p>

<div style="max-width:500px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
    <h3 style="margin:0">Notifications</h3>
    <htx:component src="/ui/badge.htx" variant="secondary"><span id="notif-count">0</span> new</htx:component>
  </div>

  <div id="notif-list" style="display:grid;gap:0.5rem;max-height:400px;overflow-y:auto"></div>

  <button id="sim-notif" class="ui-btn ui-btn-outline ui-btn-sm" style="margin-top:1rem">Simulate Notification</button>

  <div style="margin-top:1rem;font-family:monospace;font-size:0.75rem;background:var(--ui-bg-muted);padding:0.75rem;border-radius:6px">
    <htx:if test="notifyToken">
    Channel token: <span style="word-break:break-all"><htx:v>notifyToken</htx:v></span>
    </htx:if>
    <htx:else>
    No channel token (grant provider not active for this module)
    </htx:else>
  </div>
</div>

<script>
(function() {
  var list = document.getElementById('notif-list');
  var countEl = document.getElementById('notif-count');
  var count = 0;
  var types = [
    { icon: '📝', text: 'New post published', color: '#3b82f6' },
    { icon: '💬', text: 'New comment received', color: '#22c55e' },
    { icon: '👤', text: 'User signed up', color: '#8b5cf6' },
    { icon: '🔔', text: 'Deployment succeeded', color: '#f59e0b' },
    { icon: '⚠️', text: 'Rate limit approaching', color: '#ef4444' },
  ];

  function addNotification(notif) {
    count++;
    countEl.textContent = count;
    var el = document.createElement('div');
    el.style.cssText = 'display:flex;gap:0.75rem;padding:0.75rem;border:1px solid var(--ui-border);border-radius:6px;border-left:3px solid ' + notif.color + ';animation:fadeIn 0.3s';
    el.innerHTML = '<span style="font-size:1.2rem">' + notif.icon + '</span><div><strong style="font-size:0.85rem">' + notif.text + '</strong><div style="font-size:0.7rem;color:var(--ui-text-muted)">Just now</div></div>';
    list.prepend(el);
    if (list.children.length > 20) list.lastChild.remove();
  }

  document.getElementById('sim-notif').addEventListener('click', function() {
    var n = types[Math.floor(Math.random() * types.length)];
    addNotification(n);
  });

  // In production: channel('wss://host/api/channel/notifications', token)
  //   .on('notification', addNotification);
})();
</script>

<style>@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }</style>

<div style="margin-top:2rem;padding:1rem;background:var(--ui-bg-muted);border-radius:8px;font-size:0.85rem">
  <strong>What this replaces:</strong> Pusher or Socket.io client + useEffect subscription + global notification store (Redux/Zustand) + toast component library + notification count in header state. Here: htx:grant issues a scoped token. The script connects to a channel and prepends notifications as they arrive.
</div>

<p style="margin-top:1.5rem"><a href="/cookbook">&larr; Cookbook</a></p>
