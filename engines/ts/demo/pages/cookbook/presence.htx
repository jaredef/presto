<!-- MID-DEPTH (Layer 4): Collaborative presence indicator.
     Replaces: WebSocket library + global state + avatar components + connection management.
     htx:grant issues a scoped token. Script shows simulated online users. -->

<htx:grant type="channel" module="builder" as="presenceToken" />

<h1>Presence Indicator</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1.5rem">Who's online, via channel. Replaces Pusher presence + global state.</p>

<div style="max-width:500px">
  <div style="padding:1.5rem;border:1px solid var(--ui-border);border-radius:8px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
      <h3 style="margin:0">Currently Online</h3>
      <span id="online-count" style="font-size:0.85rem;color:var(--ui-text-muted)">0 users</span>
    </div>
    <div id="presence-list" style="display:flex;flex-wrap:wrap;gap:0.5rem"></div>
  </div>

  <div style="display:flex;gap:0.5rem;margin-top:1rem">
    <button id="add-user" class="ui-btn ui-btn-outline ui-btn-sm">Simulate User Join</button>
    <button id="remove-user" class="ui-btn ui-btn-ghost ui-btn-sm">Simulate User Leave</button>
  </div>
</div>

<script>
(function() {
  var list = document.getElementById('presence-list');
  var countEl = document.getElementById('online-count');
  var users = [];
  var names = ['Alice', 'Bob', 'Carol', 'Dave', 'Eve', 'Frank', 'Grace', 'Heidi'];
  var colors = ['#ef4444', '#3b82f6', '#22c55e', '#f59e0b', '#8b5cf6', '#ec4899', '#14b8a6', '#f97316'];

  function render() {
    list.innerHTML = users.map(function(u) {
      return '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0.75rem;background:var(--ui-bg-muted);border-radius:100px;font-size:0.8rem">'
        + '<div style="width:8px;height:8px;border-radius:50%;background:' + u.color + '"></div>'
        + u.name + '</div>';
    }).join('');
    countEl.textContent = users.length + ' user' + (users.length !== 1 ? 's' : '');
  }

  document.getElementById('add-user').addEventListener('click', function() {
    if (users.length >= names.length) return;
    var available = names.filter(function(n) { return !users.find(function(u) { return u.name === n; }); });
    if (available.length === 0) return;
    var name = available[Math.floor(Math.random() * available.length)];
    var idx = names.indexOf(name);
    users.push({ name: name, color: colors[idx] });
    render();
  });

  document.getElementById('remove-user').addEventListener('click', function() {
    if (users.length === 0) return;
    users.splice(Math.floor(Math.random() * users.length), 1);
    render();
  });

  // In production: channel('wss://host/api/channel/presence', token)
  //   .on('join', function(u) { users.push(u); render(); })
  //   .on('leave', function(u) { users = users.filter(...); render(); });
})();
</script>

<div style="margin-top:2rem;padding:1rem;background:var(--ui-bg-muted);border-radius:8px;font-size:0.85rem">
  <strong>What this replaces:</strong> Pusher presence channel + usePresence hook + global user list store + connection status management + avatar components with online indicators. Here: htx:grant issues a scoped token. The script subscribes to a presence channel and updates a simple user list.
</div>

<p style="margin-top:1.5rem"><a href="/cookbook">&larr; Cookbook</a></p>
