<h1>Code Splitting → Per-Page by Architecture</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1rem">Each response is self-contained. There is no bundle. There is nothing to split.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
  <div>
    <h3>React Code Splitting</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>// Dynamic imports for route-based splitting
const BlogPage = lazy(() =&gt; import('./BlogPage'));
const AdminPage = lazy(() =&gt; import('./AdminPage'));

// Requires: bundler chunk configuration,
// Suspense fallbacks for loading states,
// preload hints for critical routes,
// webpack magic comments for chunk naming</code></pre>
  </div>
  <div>
    <h3>PRESTO</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>&lt;!-- Each .htx file is its own "chunk" --&gt;
&lt;!-- by architecture: --&gt;

/blog     → blog/index.htx → HTML response
/admin    → admin/index.htx → HTML response

&lt;!-- Each response contains exactly what
     that page needs. Nothing more.
     Layer 0: 0 KB JS
     Layer 2: ~3 KB (signals)
     No shared bundle. No splitting needed.
     The architecture is additive. --&gt;</code></pre>
  </div>
</div>

<h3 style="margin-top:2rem">Response sizes for different pages on this server</h3>
<div id="size-results" style="font-family:monospace;background:#f5f5f5;padding:1rem;border-radius:8px;font-size:0.85rem;line-height:1.8">
  Loading sizes...
</div>

<script>
  var paths = ['/', '/blog', '/blog/hello-world', '/healthz', '/reorientation/build'];
  var results = document.getElementById('size-results');
  results.innerHTML = '';
  paths.forEach(function(p) {
    fetch(p).then(function(r) { return r.text(); }).then(function(body) {
      var kb = (body.length / 1024).toFixed(1);
      results.innerHTML += p + ': <strong>' + kb + ' KB</strong> (self-contained)<br>';
    });
  });
</script>

<p style="margin-top:1.5rem"><a href="/reorientation">&larr; All reorientations</a></p>
