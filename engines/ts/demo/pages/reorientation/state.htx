<htx:data type="post" where="status = 'published'" order="id desc" limit="3" as="posts" />
<htx:let totalPosts="3" />

<h1>Redux → The Document IS the State</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1rem">When the server renders the data into the HTML, there is no coordination problem to solve.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
  <div>
    <h3>React + Redux</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>// store.ts
const store = configureStore({
  reducer: { posts: postsReducer }
});

// postsSlice.ts
const postsSlice = createSlice({
  name: 'posts',
  initialState: { items: [], loading: true },
  reducers: { ... },
  extraReducers: { ... }
});

// PostList.tsx
function PostList() {
  const posts = useSelector(s =&gt; s.posts.items);
  const dispatch = useDispatch();
  useEffect(() =&gt; {
    dispatch(fetchPosts());
  }, []);
  // loading state, error state, stale state...
}</code></pre>
  </div>
  <div>
    <h3>PRESTO (Layer 0)</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>&lt;!-- The data IS in the document --&gt;
&lt;htx:data type="post"
  where="status = 'published'"
  as="posts" /&gt;

&lt;htx:each items="posts" as="post"&gt;
  &lt;div data-id="{htx:post.id}"&gt;
    &lt;htx:v&gt;post.title&lt;/htx:v&gt;
  &lt;/div&gt;
&lt;/htx:each&gt;

&lt;!-- Need to read this data in a script? --&gt;
&lt;script&gt;
  // The DOM is the store:
  var titles = document.querySelectorAll('[data-id]');
  // No Redux. No dispatch. No selector.
&lt;/script&gt;</code></pre>
  </div>
</div>

<h3 style="margin-top:2rem">Live: The document contains the state</h3>
<div style="display:grid;gap:0.75rem">
  <htx:each items="posts" as="post">
  <div data-post-id="{htx:post.id}" style="padding:0.75rem;border:1px solid var(--ui-border);border-radius:6px">
    <strong><htx:v>post.title</htx:v></strong> — <htx:v>post.status</htx:v>
  </div>
  </htx:each>
</div>
<p id="state-readout" style="margin-top:1rem;color:var(--ui-text-muted)"></p>

<script>
  var posts = document.querySelectorAll('[data-post-id]');
  document.getElementById('state-readout').textContent =
    'Script read ' + posts.length + ' posts from the DOM. No store needed.';
</script>

<p style="margin-top:1.5rem"><a href="/reorientation">&larr; All reorientations</a></p>
