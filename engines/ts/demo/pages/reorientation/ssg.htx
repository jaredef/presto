<htx:data type="post" where="status = 'published'" order="id desc" limit="3" as="posts" />

<h1>SSG → Layer 0 + Cache-Control</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1rem">Static generation is an HTTP cache header, not a build step.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
  <div>
    <h3>React (Next.js SSG)</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>// pages/posts.tsx
export async function getStaticProps() {
  const posts = await db.query(...);
  return {
    props: { posts },
    // Must rebuild + redeploy for changes
  };
}
// Requires: build step, deploy pipeline,
// static/dynamic classification per page</code></pre>
  </div>
  <div>
    <h3>PRESTO (Layer 0 + cache module)</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>&lt;!-- Same template as SSR. Unchanged. --&gt;
&lt;htx:data type="post" as="posts" /&gt;
&lt;htx:each items="posts" as="post"&gt;
  ...
&lt;/htx:each&gt;

// Cache module adds:
// Cache-Control: public, max-age=3600
// ETag: "a1b2c3d4"</code></pre>
  </div>
</div>

<h3 style="margin-top:2rem">Response Headers (from cache module)</h3>
<p style="font-family:monospace;font-size:0.85rem;background:#f5f5f5;padding:1rem;border-radius:8px">
  Cache-Control: public, max-age=3600<br>
  ETag: content-hashed<br>
  <em>The template is unchanged. Caching is infrastructure, not application code.</em>
</p>

<p style="margin-top:1.5rem"><a href="/reorientation">&larr; All reorientations</a></p>
