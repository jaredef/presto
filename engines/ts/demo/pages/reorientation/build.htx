<h1>Bundlers → Nothing</h1>
<p style="color:var(--ui-text-muted);margin-bottom:1rem">No webpack. No Vite. No turbopack. No esbuild. Edit, save, reload.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
  <div>
    <h3>React Build Tooling</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>// package.json dependencies for Next.js:
"dependencies": {
  "next": "^14.0.0",
  "react": "^18.0.0",
  "react-dom": "^18.0.0"
}
"devDependencies": {
  "typescript": "^5.0.0",
  "@types/react": "^18.0.0",
  "tailwindcss": "^3.0.0",
  "autoprefixer": "^10.0.0",
  "postcss": "^8.0.0"
}

// node_modules: ~300MB
// Build time: 10-60 seconds
// next.config.js, tsconfig.json,
// tailwind.config.js, postcss.config.js...</code></pre>
  </div>
  <div>
    <h3>PRESTO</h3>
    <pre style="background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:8px;font-size:0.8rem;overflow-x:auto;line-height:1.6"><code>// package.json:
{
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts"
  }
}

// External dependencies: 0
// node_modules: does not exist
// Build step: does not exist
// Config files: 0

// Feedback loop:
// 1. Edit .htx file
// 2. Save
// 3. Reload browser
// That's it.</code></pre>
  </div>
</div>

