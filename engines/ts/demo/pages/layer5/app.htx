<htx:layout none />
<htx:data type="task" order="id desc" limit="50" as="tasks" />
<htx:grant type="channel" module="builder" as="appToken" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Layer 5 — Task Manager</title>
  <link rel="stylesheet" href="/css/presto-ui.css">
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; padding: 2rem; background: #fafafa; color: #1a1a1a; }
    .app-container { max-width: 700px; margin: 0 auto; }
    .task-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border: 1px solid #e5e5e5; border-radius: 8px; margin-bottom: 0.5rem; background: #fff; }
    .task-item.done { opacity: 0.5; text-decoration: line-through; }
    .task-title { flex: 1; }
    .task-badge { font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 100px; }
    .task-badge.high { background: #fef2f2; color: #ef4444; }
    .task-badge.medium { background: #fffbeb; color: #f59e0b; }
    .task-badge.low { background: #f0fdf4; color: #22c55e; }
    .stats { display: flex; gap: 1.5rem; margin-bottom: 1.5rem; }
    .stat-box { text-align: center; }
    .stat-num { font-size: 1.5rem; font-weight: 700; }
    .stat-label { font-size: 0.75rem; color: #888; }
    .filter-bar { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .filter-btn { padding: 0.35rem 0.75rem; border: 1px solid #e5e5e5; border-radius: 6px; background: #fff; cursor: pointer; font-size: 0.8rem; }
    .filter-btn.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
    .add-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .add-form input { flex: 1; padding: 0.5rem 0.75rem; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 0.9rem; }
    .add-form button { padding: 0.5rem 1rem; border: none; border-radius: 6px; background: #1a1a1a; color: #fff; cursor: pointer; font-size: 0.9rem; }
  </style>
</head>
<body>
<div class="app-container">
  <h1>Task Manager</h1>
  <p style="color:#888;margin-bottom:0.5rem">Layer 5 — Full client-side interactivity. Components, state, computed values, effects.</p>
  <p style="color:#888;margin-bottom:1.5rem;font-size:0.85rem"><a href="/layer5">&larr; Back to Layer 5 First</a></p>

  <!-- Stats (computed from state) -->
  <div class="stats">
    <div class="stat-box"><div class="stat-num" id="stat-total">0</div><div class="stat-label">Total</div></div>
    <div class="stat-box"><div class="stat-num" id="stat-todo">0</div><div class="stat-label">To Do</div></div>
    <div class="stat-box"><div class="stat-num" id="stat-progress">0</div><div class="stat-label">In Progress</div></div>
    <div class="stat-box"><div class="stat-num" id="stat-done">0</div><div class="stat-label">Done</div></div>
  </div>

  <!-- Add task -->
  <div class="add-form">
    <input type="text" id="new-task" placeholder="Add a task..." />
    <button id="add-btn">Add</button>
  </div>

  <!-- Filter bar -->
  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="todo">To Do</button>
    <button class="filter-btn" data-filter="in-progress">In Progress</button>
    <button class="filter-btn" data-filter="done">Done</button>
  </div>

  <!-- Task list (server-rendered initial data, client takes over) -->
  <div id="task-list">
    <htx:each items="tasks" as="task">
    <div class="task-item" data-id="{htx:task.id}" data-status="{htx:task.status}" data-priority="{htx:task.priority}">
      <input type="checkbox" class="task-check" />
      <span class="task-title"><htx:v>task.title</htx:v></span>
      <span class="task-badge {htx:task.priority}"><htx:v>task.priority</htx:v></span>
      <select class="task-status" style="font-size:0.75rem;padding:0.2rem;border:1px solid #e5e5e5;border-radius:4px">
        <option value="todo">To Do</option>
        <option value="in-progress">In Progress</option>
        <option value="done">Done</option>
      </select>
      <button class="task-delete" style="border:none;background:none;color:#ef4444;cursor:pointer;font-size:1rem">&times;</button>
    </div>
    </htx:each>
  </div>

  <div style="margin-top:2rem;padding:1rem;background:#f0f0f0;border-radius:8px;font-size:0.85rem">
    <strong>This is Layer 5.</strong> The server rendered the initial HTML (with data from SQLite). The client script below manages all interactivity: adding tasks, toggling status, filtering, computed stats. This is the React developer's mental model — state, computed values, effects, event handlers. It works here. It's home.
    <br><br>
    <strong>Now look at the escapes.</strong> The data was server-rendered (Layer 0 could handle the list). The form could be a native HTML form with a signed token (Layer 0). Auth gating could be htx:auth (Layer 0). The escape hatches dissolve the compensations you'd need if this were a React SPA.
  </div>
</div>

<script src="/js/presto-signals.js"></script>
<script>
(function() {
  // STATE — like useState in React
  var tasks = signal([]);
  var filter = signal('all');

  // Initialize from server-rendered DOM
  var items = document.querySelectorAll('.task-item');
  var initial = [];
  items.forEach(function(el) {
    initial.push({
      id: parseInt(el.dataset.id),
      title: el.querySelector('.task-title').textContent,
      status: el.dataset.status,
      priority: el.dataset.priority,
    });
  });
  tasks.value = initial;

  // COMPUTED — like useMemo in React
  var filteredTasks = computed(function() {
    var f = filter.value;
    if (f === 'all') return tasks.value;
    return tasks.value.filter(function(t) { return t.status === f; });
  });

  var stats = computed(function() {
    var all = tasks.value;
    return {
      total: all.length,
      todo: all.filter(function(t) { return t.status === 'todo'; }).length,
      progress: all.filter(function(t) { return t.status === 'in-progress'; }).length,
      done: all.filter(function(t) { return t.status === 'done'; }).length,
    };
  });

  // EFFECTS — like useEffect in React
  effect(function() {
    var s = stats.value;
    document.getElementById('stat-total').textContent = s.total;
    document.getElementById('stat-todo').textContent = s.todo;
    document.getElementById('stat-progress').textContent = s.progress;
    document.getElementById('stat-done').textContent = s.done;
  });

  effect(function() {
    var list = document.getElementById('task-list');
    var ft = filteredTasks.value;
    list.innerHTML = ft.map(function(t) {
      var checked = t.status === 'done' ? ' checked' : '';
      var doneClass = t.status === 'done' ? ' done' : '';
      return '<div class="task-item' + doneClass + '" data-id="' + t.id + '">'
        + '<input type="checkbox" class="task-check"' + checked + ' />'
        + '<span class="task-title">' + t.title + '</span>'
        + '<span class="task-badge ' + t.priority + '">' + t.priority + '</span>'
        + '<select class="task-status" style="font-size:0.75rem;padding:0.2rem;border:1px solid #e5e5e5;border-radius:4px">'
        + '<option value="todo"' + (t.status === 'todo' ? ' selected' : '') + '>To Do</option>'
        + '<option value="in-progress"' + (t.status === 'in-progress' ? ' selected' : '') + '>In Progress</option>'
        + '<option value="done"' + (t.status === 'done' ? ' selected' : '') + '>Done</option>'
        + '</select>'
        + '<button class="task-delete" style="border:none;background:none;color:#ef4444;cursor:pointer;font-size:1rem">&times;</button>'
        + '</div>';
    }).join('');
  });

  // EVENT HANDLERS — like onClick in React
  document.getElementById('add-btn').addEventListener('click', function() {
    var input = document.getElementById('new-task');
    var title = input.value.trim();
    if (!title) return;
    var newId = Math.max.apply(null, tasks.value.map(function(t) { return t.id; }).concat([0])) + 1;
    tasks.value = tasks.value.concat([{ id: newId, title: title, status: 'todo', priority: 'medium' }]);
    input.value = '';
  });

  document.getElementById('task-list').addEventListener('change', function(e) {
    if (e.target.classList.contains('task-status')) {
      var id = parseInt(e.target.closest('.task-item').dataset.id);
      var newStatus = e.target.value;
      tasks.value = tasks.value.map(function(t) { return t.id === id ? Object.assign({}, t, { status: newStatus }) : t; });
    }
    if (e.target.classList.contains('task-check')) {
      var id = parseInt(e.target.closest('.task-item').dataset.id);
      tasks.value = tasks.value.map(function(t) {
        return t.id === id ? Object.assign({}, t, { status: e.target.checked ? 'done' : 'todo' }) : t;
      });
    }
  });

  document.getElementById('task-list').addEventListener('click', function(e) {
    if (e.target.classList.contains('task-delete')) {
      var id = parseInt(e.target.closest('.task-item').dataset.id);
      tasks.value = tasks.value.filter(function(t) { return t.id !== id; });
    }
  });

  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      filter.value = btn.dataset.filter;
    });
  });
})();
</script>
</body>
</html>
