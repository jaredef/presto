<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Module Kit Demo</title>
  <link rel="stylesheet" href="/css/presto-ui.css">
  <style>
    body { font-family: system-ui, sans-serif; background: #fafafa; color: #1a1a1a; margin: 0; }
    .app-header { background: #fff; border-bottom: 1px solid #e5e5e5; padding: 0.75rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .app-logo { font-weight: 800; font-size: 1.1rem; text-decoration: none; color: #1a1a1a; }
    .app-nav { display: flex; gap: 1.25rem; font-size: 0.875rem; }
    .app-nav a { color: #666; text-decoration: none; }
    .app-nav a:hover { color: #1a1a1a; }
    .app-main { max-width: 900px; margin: 2rem auto; padding: 0 1.5rem; }
    .auth-badge { font-size: 0.8rem; padding: 0.25rem 0.75rem; border-radius: 100px; }
    .auth-badge.guest { background: #f0f0f0; color: #888; }
    .auth-badge.user { background: #dcfce7; color: #166534; }
  </style>
</head>
<body>
  <header class="app-header">
    <a href="/" class="app-logo">Module Kit Demo</a>
    <nav class="app-nav">
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
      <a href="/modules">Modules</a>
      <htx:auth>
        <span class="auth-badge user"><htx:v>auth.user.name</htx:v> (<htx:v>auth.user.role</htx:v>)</span>
      </htx:auth>
      <htx:unauth>
        <span class="auth-badge guest">Guest</span>
      </htx:unauth>
    </nav>
  </header>
  <main class="app-main">
    __content__
  </main>
</body>
</html>
