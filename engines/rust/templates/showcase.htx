<htx:layout none />
<htx:include src="/partials/nav.htx" />
<htx:component src="components/card.htx" title="Hello">
  <p>Slot content here.</p>
</htx:component>

<htx:let greeting="Welcome" />
<p><htx:v>greeting</htx:v></p>

<htx:auth><p>Logged in</p></htx:auth>
